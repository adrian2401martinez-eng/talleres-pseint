Algoritmo Sumarciclo
    Definir n, i, suma Como Entero
    Escribir "por favor digite hasta que numero quiere su ciclo:"
    Leer n
    suma <- 0
    Para i <- 1 Hasta n Con Paso 1 Hacer
        Escribir "Número: ", i
        suma <- suma + i
    FinPara
    Escribir "La suma total desde 1 hasta ", n, " es: ", suma
FinAlgoritmo