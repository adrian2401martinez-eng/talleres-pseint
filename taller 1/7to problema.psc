Algoritmo areaderectangulo
	Definir base, aultura, area Como Real
	Escribir 'vamos a allar el area de un rectangulo'
	Escribir 'por favor digita la base del rectangulo'
	Leer base
	Escribir 'por favor digita la altura del rectangulo'
	Leer altura
	area <- base*altura
	Escribir 'el area de un rectangulo es:', area
FinAlgoritmo
