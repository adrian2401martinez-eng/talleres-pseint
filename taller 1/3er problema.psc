Algoritmo operacion4valores
	Definir valor1, valor2, valor3, valor4, resultado1, resultado2 Como Real
	Escribir 'vamos a hacer la suma de 3 valores y restarles 1 valor'
	Escribir 'por favor digita el valor1 en numeros'
	Leer valor1
	Escribir 'por favor digita el valor2 en numeros'
	Leer valor2
	Escribir 'por favor digita el valor3 en numeros'
	Leer valor3
	resultado1 <- valor1+valor2+valor3
	Escribir 'el resultado de la sumatoria es:', resultado1
	Escribir ' ahora haremos la resta'
	Escribir 'por favor digita el valor4 en numeros'
	Leer valor4
	resultado2 <- resultado1-valor4
	Escribir 'el resultado de la operacion es:', resultado2
FinAlgoritmo
