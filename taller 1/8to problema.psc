Algoritmo areaderombo
	Definir diagonalmenor, diagonalmayor, area Como Real
	Escribir 'vamos a allar el area de un rombo'
	Escribir 'por favor digita el diagonal menor'
	Leer diagonalmenor
	Escribir 'por favor digita el diagonal mayor'
	Leer diagonalmayor
	area <- (diagonalmenor*diagonalmayor)/2
	Escribir 'el area del rombo es:', area
FinAlgoritmo
