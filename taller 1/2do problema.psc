Algoritmo suma3valores
	Definir valor1, valor2, valor3, resultado Como Real
	Escribir 'vamos a hacer la sumatoria de 3 valores'
	Escribir 'por favor digita el valor1 en numeros'
	Leer valor1
	Escribir 'por favor digita el valor2 en numeros'
	Leer valor2
	Escribir 'por favor digita el valor3 en numeros'
	Leer valor3
	resultado <- valor1+valor2+valor3
	Escribir ' el resutado de la sumatoria es:', resultado
FinAlgoritmo
