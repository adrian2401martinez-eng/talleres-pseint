Algoritmo conversionmetros
	Definir kilometros, hectometros, decametros, decimetros, centimetros, milimetros Como Real
	Escribir 'Ingrese una distancia en metros:'
	Leer Metros
	kilometros <- Metros/1000
	hectometros <- Metros/100
	decametros <- Metros/10
	decimetros <- Metros*10
	centimetros <- Metros*100
	milimetros <- Metros*1000
	Escribir 'Valor original: ', Metros, ' metros.'
	Escribir 'Kilómetros: ', kilometros
	Escribir 'Hectómetros: ', hectometros
	Escribir 'Decámetros: ', decametros
	Escribir 'Decímetros: ', decimetros
	Escribir 'Centímetros: ', centimetros
	Escribir 'Milímetros: ', milimetros
FinAlgoritmo
