Algoritmo areatrapecio
	Definir basemenor, basemayor, altura, area Como Real
	Escribir 'vamos a allar el area de un trapecio'
	Escribir 'por favor digita la base menor'
	Leer basemenor
	Escribir 'por favor digita la base mayor'
	Leer basemayor
	Escribir 'por favor digita la altura'
	Leer altura
	area <- ((basemenor*basemayor)/2)*altura
	Escribir 'el area del trapecio es: ', area
FinAlgoritmo
