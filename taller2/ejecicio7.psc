Algoritmo dia_semana
	definir dia Como Entero
	escribir "digite el numero del dia de la semana entre 1 al 7"
	leer dia
	segun dia Hacer
		1:escribir "lunes"
		2:escribir "martes"
		3:escribir "miercoles"
		4:escribir "jeves"
		5:escribir "viernes"
		6:escribir "sabado "
		7:escribir "domingo"
		de otro modo:
			Escribir "el  numero dado no esta entre el rango del 1 al 7"
	FinSegun
FinAlgoritmo
